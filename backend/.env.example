# Copier ce fichier en backend/.env puis adapter les valeurs.
# Ne jamais committer le fichier .env.

PORT=3000
MONGODB_URI=mongodb://127.0.0.1:27017/taskflow
CORS_ORIGIN=http://localhost:5173

# Clé de signature des JWT : mettre une longue chaîne aléatoire, propre à chacun
JWT_SECRET=remplacer-par-une-longue-chaine-aleatoire
JWT_EXPIRES_IN=7d

# Base utilisée par les tests (elle est vidée à chaque lancement : son nom doit finir par _test)
MONGODB_URI_TEST=mongodb://127.0.0.1:27017/taskflow_test
